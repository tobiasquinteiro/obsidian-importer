{
	"name": "obsidian-url-importer-add-on",
	"version": "1.8.6",
	"description": "URL importer add-on plugin for Obsidian, extracted from URL import work.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json package.json versions.json",
		"lint": "eslint src --fix",
		"test": "tsx --test tests/**/*.test.ts"
	},
	"keywords": ["url", "import", "crawler", "web-to-markdown", "web-clipper"],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@stylistic/eslint-plugin": "5.7.1",
		"@types/node": "20.19.27",
		"builtin-modules": "3.3.0",
		"esbuild": "0.25.4",
		"eslint": "9.39.2",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"tsx": "^4.21.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.51.0"
	},
	"dependencies": {}
}
